// vectors.hex：spram 的定向测试向量，由 tb_spram.sv 用 $readmemh 读入
// 格式：每行一条向量，7 位十六进制 = en(1) we(1) addr(1) wdata(2) exp(2)
//   en、we：写 0 或 1；addr：0~f；wdata：要写的数据（不写时填 00）
//   exp：这一拍上升沿之后 rdata 的期望值（读延迟 1 拍、写的那一拍读出旧值）
//        旧值不确定（地址还没写过）时写 xx
//   下划线只为好读

// ---- 场景 1：写几个地址再读回，包括地址 0 和最大地址 f ----
1_1_0_a5_xx   // 写 m[0]=a5；同时读出旧值，m[0] 没写过 → xx
1_1_f_5a_xx   // 写 m[f]=5a；旧值 xx
1_1_7_3c_xx   // 写 m[7]=3c；旧值 xx
1_0_0_00_a5   // 读 m[0] → a5
1_0_f_00_5a   // 读 m[f] → 5a
1_0_7_00_3c   // 读 m[7] → 3c

// ---- 场景 2：同一地址先后写两次，读出后写的值 ----
1_1_3_11_xx   // 写 m[3]=11；旧值 xx
1_1_3_22_11   // 再写 m[3]=22；读出旧值 11（这一条同时覆盖场景 3）
1_0_3_00_22   // 读 m[3] → 22（后写的值）

// ---- 场景 3：写的那一拍，rdata 是写之前的旧值（旧值已知）----
1_1_0_b6_a5   // 写 m[0]=b6；这一拍读出旧值 a5，不是 b6
1_0_0_00_b6   // 下一拍读 m[0] → b6

// ---- 场景 4：en=0 时写不生效、rdata 保持 ----
0_1_f_ff_b6   // en=0、we=1 想写 m[f]=ff：不生效；rdata 保持上一拍的 b6
0_0_7_00_b6   // en=0：不读不写，rdata 继续保持 b6
1_0_f_00_5a   // 读 m[f] → 还是 5a，证明上面那次写没生效

// ---- 场景 5：每拍换一个地址连续读，每拍都对 ----
1_0_0_00_b6   // 读 m[0]
1_0_3_00_22   // 读 m[3]
1_0_7_00_3c   // 读 m[7]
1_0_f_00_5a   // 读 m[f]
1_0_0_00_b6   // 再读 m[0]